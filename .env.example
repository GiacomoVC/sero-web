# ─── Supabase (primary datastore + auth) ─────────────────────────────────────
# Project → Settings → API. The anon key is public (used by the browser);
# the service-role key is SECRET (server-only, bypasses RLS) — never expose it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Your public site URL. Used to build personalized links and IG story URLs.
# In Vercel, VERCEL_URL is auto-set so you can leave this empty in preview.
# In production, set this to https://sero.app (or your final domain).
NEXT_PUBLIC_SITE_URL=

# Admin gate for /api/plans (the matching dashboard). Any long random string.
WEBHOOK_SECRET=

# ─── Legacy: Google Apps Script / Sheets (DEPRECATED) ────────────────────────
# Only needed to run scripts/migrate-to-supabase.mjs once, to pull the old
# Sheet rows into Supabase. The app no longer reads/writes Sheets at runtime.
APPS_SCRIPT_URL=
