# Google Apps Script Web App URL (Deploy → New deployment → Web app)
APPS_SCRIPT_URL=

# Optional shared secret. Set the same value as a Script Property
# in your Apps Script (Project Settings → Script Properties → WEBHOOK_SECRET).
WEBHOOK_SECRET=

# Your public site URL. Used to build personalized links and IG story URLs.
# In Vercel, Vercel auto-sets VERCEL_URL so you can leave this empty in preview.
# In production, set this to https://sero.app (or your final domain).
NEXT_PUBLIC_SITE_URL=
